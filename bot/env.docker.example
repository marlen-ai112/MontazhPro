# Скопируйте этот файл в .env.bot (в корне проекта) и впишите свои значения.
# Файл .env.bot не попадает в git.
TELEGRAM_BOT_TOKEN=вставьте_токен_от_BotFather
ALLOWED_CHAT_IDS=вставьте_свой_chat_id
# Когда проверять порталы (по времени Казахстана). Госзакупки и Самрук-Қазына приходят двумя отдельными списками по возрастанию суммы.
# TENDERS_TIMES=09:00,13:00
# TENDERS_MIN_PRICE=1500000   сумма от, тг
# TENDERS_MAX_PRICE=5000000   сумма до, тг (0 = без верхней границы, «от 1,5 млн и выше»)
# Отдельный бот только для рассылки закупок (создайте в @BotFather, откройте его в Telegram и нажмите «Запустить»):
# TENDERS_BOT_TOKEN=токен_второго_бота
# Необязательно: ключ Anthropic включает агента «Спецификации» (разбор лотов: какой точно товар нужен)
# и свободный чат с ИИ. Без ключа работают /tenders, рассылка закупок, цены и маржа.
# ANTHROPIC_API_KEY=вставьте_ключ_Anthropic
# TENDERS_AI=demand      demand — разбор только по команде /tender (по умолчанию, дешевле), auto — и по каждой новой закупке, off — выключен
# AGENT_MODEL=claude-haiku-5-5   дешёвая модель вместо claude-sonnet-5-5

# Приложение «AI-офис» (открывается в браузере iPhone: http://IP_сервера:8787).
# Придумайте длинный ключ доступа (от 12 символов). Без него приложение выключено.
# APP_KEY=придумайте_длинный_ключ

# Видеомонтаж рилс. Субтитры по речи только с ключом распознавания речи (Whisper-совместимый API, например Groq):
# STT_API_KEY=ключ
# STT_BASE_URL=https://api.groq.com/openai/v1
# STT_MODEL=whisper-large-v3
# VIDEO_MAX_MB=150
